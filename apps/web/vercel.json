{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build",
  "functions": {
    "src/app/api/**/route.ts": { "maxDuration": 300 }
  },
  "crons": [{ "path": "/api/cron/recover", "schedule": "*/10 * * * *" }]
}
